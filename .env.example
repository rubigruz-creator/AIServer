# =============================================================================
# cp .env.example .env && nano .env
# =============================================================================

# --- Домен (без https://) ---
DOMAIN=agent.remont-gazon.ru

# Email для Let's Encrypt / certbot
LETSENCRYPT_EMAIL=admin@example.com

# --- Open WebUI ---
# Секрет сессий (64 hex-символа):
#   Ubuntu:  openssl rand -hex 32
#   Windows: -join ((1..32 | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) }))
WEBUI_SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА

OLLAMA_DEFAULT_MODEL=truck-service
# Сколько держать модель в RAM без запросов (30m, 1h, -1 = не выгружать)
OLLAMA_KEEP_ALIVE=-1
# Лимит токенов ответа виджета (быстрее на CPU; intake-api подставляет по умолчанию)
CHAT_DEFAULT_NUM_PREDICT=384
WEBUI_ENABLE_SIGNUP=false
WEBUI_DEFAULT_LOCALE=ru-RU

# Админ (создаётся при пустой базе Open WebUI)
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ
WEBUI_ADMIN_NAME=Администратор

# true = настройки хранятся в БД WebUI; false = .env приоритетнее при старте
ENABLE_PERSISTENT_CONFIG=false

# --- Embed-виджет (Phase 2) ---
# API-ключ создаётся в Open WebUI для сервисного пользователя widget@...
# Хранится ТОЛЬКО на сервере в /etc/nginx/conf.d/aiserver-widget-api-key.conf
WIDGET_SERVICE_EMAIL=widget@remont-gazon.ru
WIDGET_DEFAULT_MODEL=truck-service

# Права чата (defaults для Open WebUI; см. docker-compose.yml)
WEBUI_CHAT_CONTROLS=false
WEBUI_CHAT_TEMPORARY=true
WEBUI_FEATURES_API_KEYS=true

# --- Intake API (диалоги виджета + админ-страница) ---
# Админ: https://agent.remont-gazon.ru/intake/admin
INTAKE_ADMIN_USER=admin
INTAKE_ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ
# Опционально: webhook для n8n / MAX / Telegram (JSON POST при новой заявке)
INTAKE_WEBHOOK_URL=
# Удалять при старте intake-api диалоги с числом сообщений < N (0 = выкл.)
INTAKE_AUTO_PURGE_MIN_MESSAGES=3

# --- RAG (база знаний для виджета, prompts/knowledge) ---
# docker exec ollama ollama pull nomic-embed-text
RAG_ENABLED=true
RAG_TOP_K=3
RAG_EMBED_MODEL=nomic-embed-text
# false = поиск по ключевым словам (быстро); true = + embedding на каждый FAQ-запрос
RAG_USE_EMBEDDINGS=false

# --- n8n (опционально, docker compose --profile automation up -d) ---
N8N_HOST=n8n.example.com
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=ЗАМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ
N8N_ENCRYPTION_KEY=ЗАМЕНИТЕ_32_СИМВОЛА_МИНИМУМ

TZ=Europe/Moscow
