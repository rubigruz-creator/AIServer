# Шаблон Nginx для продакшена: HestiaCP + Open WebUI.
# Скопировать на сервер:
#   sed "s/agent.remont-gazon.ru/YOUR_DOMAIN/g" nginx/hestia-zz-agent-webui.conf.example \
#     > /etc/nginx/conf.d/zz-agent-webui.conf
#
# ВАЖНО: listen по IP VPS (как у Hestia), иначе запросы уйдут в заглушку «Coming Soon».
# Не используйте Rebuild домена в Hestia для agent.* — перезапишет конфиги.

server {
    listen 90.156.171.36:80;
    listen [::]:80;
    server_name agent.remont-gazon.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 90.156.171.36:443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name agent.remont-gazon.ru;

    ssl_certificate     /home/rubi/conf/web/agent.remont-gazon.ru/ssl/agent.remont-gazon.ru.pem;
    ssl_certificate_key /home/rubi/conf/web/agent.remont-gazon.ru/ssl/agent.remont-gazon.ru.key;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
