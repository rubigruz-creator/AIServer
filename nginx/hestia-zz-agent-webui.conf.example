# Шаблон Nginx для продакшена: HestiaCP + Open WebUI + embed-виджет.
# Скопировать на сервер:
#   sed "s/agent.remont-gazon.ru/YOUR_DOMAIN/g" nginx/hestia-zz-agent-webui.conf.example \
#     > /etc/nginx/conf.d/zz-agent-webui.conf
#
# Ключ API виджета (отдельный файл, см. nginx/widget-api-key.conf.example):
#   cp nginx/widget-api-key.conf.example /etc/nginx/conf.d/aiserver-widget-api-key.conf
#
# ВАЖНО: listen по IP VPS (как у Hestia), иначе запросы уйдут в заглушку «Coming Soon».
# Не используйте Rebuild домена в Hestia для agent.* — перезапишет конфиги.

# Подключается на уровне http {}; файл создаётся на сервере с реальным ключом.
include /etc/nginx/conf.d/aiserver-widget-api-key.conf;

server {
    listen 90.156.171.36:80;
    listen [::]:80;
    server_name agent.remont-gazon.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 90.156.171.36:443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name agent.remont-gazon.ru;

    ssl_certificate     /home/rubi/conf/web/agent.remont-gazon.ru/ssl/agent.remont-gazon.ru.pem;
    ssl_certificate_key /home/rubi/conf/web/agent.remont-gazon.ru/ssl/agent.remont-gazon.ru.key;

    client_max_body_size 50M;

    # --- Виджет: прокси API (ключ только на сервере, не в браузере) ---
    location /embed/api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer $widget_api_key";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    # --- Виджет: прямой прокси в Ollama для чата (обход бага Open WebUI v0.9.5 API) ---
    location = /embed/ollama/chat {
        proxy_pass http://127.0.0.1:11434/api/chat;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    # --- Intake API: диалоги, заявки, админ-страница ---
    location /intake/ {
        proxy_pass http://127.0.0.1:3100/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # --- Виджет: статика (launcher + chat UI) ---
    # Файлы публикуются в /var/www/aiserver/embed, т.к. nginx-воркер
    # не может читать /root/AIServer/* при стандартных правах /root (0700).
    location /embed/ {
        alias /var/www/aiserver/embed/;
        add_header Cache-Control "public, max-age=3600";
        add_header Access-Control-Allow-Origin "*";
        add_header Content-Security-Policy "frame-ancestors 'self' https://ons.remont-gazon.ru https://remont-gazon.ru https://www.remont-gazon.ru" always;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Разрешить встраивание Open WebUI только с доверенных сайтов (если iframe на /)
        add_header Content-Security-Policy "frame-ancestors 'self' https://ons.remont-gazon.ru https://remont-gazon.ru https://www.remont-gazon.ru" always;
        proxy_hide_header X-Frame-Options;
    }
}
